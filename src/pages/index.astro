---
import Link from "../components/Link.astro";
import { siteConfig } from "../config";
import Layout from "../layouts/Default.astro";
---

<Layout title={siteConfig.title}>
	<section class="space-y-10">
		<article aria-label="Introduction">
			<p>
				A studio of one, making software for people who still care about the
				shape and feel of the things they use every day. Most of what I build
				starts as a tool I wanted for my own work, and sometimes it turns out
				well enough to share.
			</p>
		</article>

		<article>
			<h3 class="text-muted-foreground">Projects</h3>
			<ul class="space-y-2">
				{
					siteConfig.projects.map((project) => (
						<li>
							<p>
								{project.href ? (
									<Link href={project.href}>{project.name}</Link>
								) : (
									<span class="text-foreground">{project.name}</span>
								)}
								{project.note && (
									<span class="text-muted-foreground"> ({project.note})</span>
								)}
							</p>
							<p class="text-muted-foreground">{project.description}</p>
						</li>
					))
				}
			</ul>
		</article>

		<article>
			<h3 class="text-muted-foreground">Contact</h3>
			<p>
				<Link href={`mailto:${siteConfig.email}`} rel="me">
					{siteConfig.email}
				</Link>
			</p>
			<p>
				<Link href={siteConfig.personalSite.href}>
					{siteConfig.personalSite.name}
				</Link>
			</p>
		</article>
	</section>
</Layout>
